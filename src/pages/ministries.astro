---
import { ArrowUpRight, Church, HandHeart } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';

const ministries = [
  { name: 'Assembly Band Movement', theme: 'Care, Keep, Strengthen', image: '/images/ministries/abm.jpg', url: 'https://www.thechurchofgod.org/abm/', copy: 'Providing every member of the local congregation with care and discipleship through prayer, Bible study, fellowship, and small-group ministry.' },
  { name: 'Bible Training Institute', theme: 'Expand, Equip, Empower', image: '/images/ministries/bti.jpg', url: 'https://www.thechurchofgod.org/bti/', copy: 'The academic arm of the Church, equipping students with biblical knowledge and practical skills for faithful and effective Christian service.' },
  { name: 'Church of Prophecy Marker Association', theme: 'Build, Beautify, Maintain', image: '/images/ministries/cpma.jpg', url: 'https://www.thechurchofgod.org/cpma/', copy: 'Remembering our history, maintaining our identity, and creating spiritual and physical markers that point people to Christ and His Church.' },
  { name: 'Evangelism', theme: 'Ready. Set. Go!', image: '/images/ministries/evangelism.jpg', url: 'https://www.thechurchofgod.org/evangelism/', copy: 'Taking the message of the Cross to every culture, community, and soul, and encouraging every believer to share the hope found in Jesus Christ.' },
  { name: 'Sunday School', theme: 'Develop, Teach, Train', image: '/images/ministries/sundayschool.jpg', url: 'https://www.thechurchofgod.org/ss/', copy: 'Helping every generation understand the saving power of Jesus Christ and continue growing through practical lessons and faithful Bible study.' },
  { name: 'Victory Leaders Band', theme: 'Discipling Youth for Service', image: '/images/ministries/vlb.jpg', url: 'https://www.thechurchofgod.org/vlb/', copy: 'Guiding children, youth, and young adults to become faithful, Spirit-filled disciples with a passion to share the Good News.' },
  { name: 'Womens Missionary Band', theme: 'Girls · Ladies · Missionaries', image: '/images/ministries/wmb.jpg', url: 'https://www.thechurchofgod.org/wmb/', copy: 'Equipping women of every age for Christian life and service while supporting home and world missions through prayer, giving, and action.' },
  { name: 'World Mission', theme: 'Coordinating Global Evangelism', image: '/images/ministries/worldmission.jpg', url: 'https://www.thechurchofgod.org/worldmission/', copy: 'Coordinating evangelism across nations to preach Christ, develop mature disciples, support people in need, and train national leaders.' },
];
---
<BaseLayout title="Ministries | The Church of God Nigeria" description="Explore the ministries of The Church of God Nigeria and connect with their international ministry resources.">
  <PageHero eyebrow="Ministries" title="How we serve." copy="Care. Discipleship. Teaching. Mission. Every ministry helps the whole Church grow stronger and carry the Gospel further." label="Explore all ministries" />

  <section id="page-content" class="bg-white py-14 sm:py-20">
    <div class="container-site">
      <div class="grid items-end gap-8 lg:grid-cols-[1.05fr_.95fr]">
        <SectionHeading eyebrow="A ministry for every season" title="Find your place in the work." />
        <p class="m-0 max-w-xl text-[1.08rem] leading-8 text-slate-600 lg:justify-self-end">Our local churches share in the same ministry purpose as The Church of God around the world. Explore each ministry below and visit its international page for resources, programmes, and updates.</p>
      </div>
    </div>
  </section>

  <div class="divide-y divide-slate-200 border-y border-slate-200">
    {ministries.map((ministry, index) => (
      <section id={ministry.name.toLowerCase().replaceAll(' ', '-')} class:list={['py-[clamp(4rem,8vw,7rem)]', index % 2 === 0 ? 'bg-cream' : 'bg-white']}>
        <div class="container-site grid items-center gap-11 lg:grid-cols-2 lg:gap-20">
          <div class:list={['overflow-hidden rounded-3xl bg-white shadow-[0_22px_60px_rgba(18,56,139,.10)]', index % 2 === 1 && 'lg:order-2']}>
            <img src={ministry.image} alt={`${ministry.name} official ministry branding`} loading={index < 2 ? 'eager' : 'lazy'} width="400" height="300" class="aspect-[4/3] h-full w-full object-cover" />
          </div>
          <div class:list={['max-w-xl', index % 2 === 1 && 'lg:order-1']}>
            <p class="eyebrow">{ministry.theme}</p>
            <h2 class="mb-0 mt-4 font-display text-[clamp(2.3rem,4.5vw,4.5rem)] font-normal leading-[1] tracking-[-.045em] text-indigo">{ministry.name}</h2>
            <p class="mb-8 mt-6 text-[1.05rem] leading-8 text-slate-600">{ministry.copy}</p>
            <a class="btn btn-primary" href={ministry.url} target="_blank" rel="noreferrer">Visit international ministry <ArrowUpRight size={17} /></a>
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="section-space bg-indigo text-white">
    <div class="container-site grid items-center gap-14 lg:grid-cols-[.8fr_1.2fr] lg:gap-24">
      <div class="rounded-3xl border border-white/15 bg-white/5 p-9 sm:p-12"><Church class="text-gold-light" size={40} stroke-width={1.4} /><h2 class="mb-0 mt-12 font-display text-[clamp(2.4rem,4vw,4rem)] font-normal leading-[1] tracking-[-.04em]">Ministry begins in the local church.</h2><p class="mb-0 mt-6 leading-8 text-white/70">These ministry areas come alive through people who teach, welcome, pray, organise, give, and serve.</p></div>
      <div id="serve"><p class="eyebrow !text-gold-light">Use your gifts</p><h2 class="mt-4 font-display text-[clamp(2.5rem,5vw,4.6rem)] font-normal leading-[1] tracking-[-.04em]">There is work for willing hands.</h2><p class="mt-6 max-w-xl text-lg leading-8 text-white/70">Speak with a local church leader about serving where your gifts, experience, and compassion can grow.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-light" href="/#find-a-church">Find a church</a><a class="btn btn-outline-light" href="/#prayer"><HandHeart size={17} /> Ask for guidance</a></div></div>
    </div>
  </section>
  <Footer />
</BaseLayout>
