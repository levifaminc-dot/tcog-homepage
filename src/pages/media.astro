---
import { ArrowUpRight, Headphones, Music2, Play, Radio, Video } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';

const youtubeUrl = 'https://www.youtube.com/@TCOG';
const spotifyUrl = 'https://open.spotify.com/show/6J4awHuptbweIxE8nMcLbT';

const platforms = [
  { icon: Video, name: 'YouTube', format: 'Messages and worship', href: youtubeUrl, cta: 'Visit channel' },
  { icon: Headphones, name: 'Spotify', format: 'Listen on the go', href: spotifyUrl, cta: 'Open in Spotify' },
  { icon: Music2, name: 'Audiomack', format: 'Audio messages', cta: 'Profile coming soon' },
  { icon: Radio, name: 'More channels', format: 'Additional platforms', cta: 'More links coming soon' },
];
---
<BaseLayout title="Media | The Church of God Nigeria" description="Watch and listen to messages, teaching, and worship from The Church of God Nigeria on YouTube and Spotify.">
  <PageHero eyebrow="Media" title="The message, wherever you are." copy="Watch messages, listen on the go, revisit a teaching, and stay connected to the life of the Church throughout the week." label="Watch and listen" />

  <section id="page-content" class="section-space bg-white">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading eyebrow="Watch on YouTube" title="Messages for everyday faith." copy="Visit our YouTube channel for messages, worship, and ministry from The Church of God Nigeria." />
        <a class="btn btn-primary" href={youtubeUrl} target="_blank" rel="noreferrer">
          <Play size={17} /> Visit YouTube <ArrowUpRight size={16} />
        </a>
      </div>
      <a href={youtubeUrl} target="_blank" rel="noreferrer" class="group relative mt-12 grid min-h-[27rem] overflow-hidden rounded-3xl bg-indigo text-white no-underline sm:min-h-[35rem]" aria-label="Watch The Church of God Nigeria on YouTube">
        <img src="/images/nigeria-worship-hero.webp" alt="Nigerian church members worshipping together" width="1792" height="896" class="absolute inset-0 h-full w-full object-cover opacity-75 transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-indigo via-indigo/20 to-transparent"></div>
        <div class="relative z-10 flex items-end justify-between gap-6 self-end p-7 sm:p-11">
          <div>
            <p class="mb-0 text-[.68rem] font-black uppercase tracking-[.14em] text-gold-light">The Church of God Nigeria</p>
            <h2 class="mb-0 mt-3 font-display text-[clamp(2.3rem,5vw,4.8rem)] font-normal leading-none tracking-[-.045em]">Watch our messages.</h2>
          </div>
          <span class="grid size-16 shrink-0 place-items-center rounded-full bg-white text-indigo shadow-2xl sm:size-20">
            <Play size={26} fill="currentColor" />
          </span>
        </div>
      </a>
    </div>
  </section>

  <section id="spotify-listen" class="section-space bg-mist">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[.42fr_.58fr] lg:gap-16">
      <div>
        <p class="eyebrow">Listen on Spotify</p>
        <h2 class="section-title">Press play.<br /><em class="text-coral">Grow anywhere.</em></h2>
        <p class="mt-6 max-w-xl text-[1.05rem] leading-8 text-slate-600">Listen to messages without leaving the page. The Spotify player gives you direct access to the Church's available audio wherever you are.</p>
        <a class="text-link mt-7" href={spotifyUrl} target="_blank" rel="noreferrer">
          Open the full show on Spotify <ArrowUpRight size={15} />
        </a>
      </div>
      <div class="overflow-hidden rounded-3xl bg-[#121212] p-3 shadow-[0_22px_60px_rgba(18,56,139,.15)] sm:p-5">
        <iframe src="https://open.spotify.com/embed/show/6J4awHuptbweIxE8nMcLbT?utm_source=generator" title="The Church of God Nigeria on Spotify" width="100%" height="352" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" allowfullscreen loading="lazy" class="block rounded-2xl"></iframe>
      </div>
    </div>
  </section>

  <section id="platforms" class="section-space bg-white">
    <div class="container-site">
      <div class="grid items-end gap-8 lg:grid-cols-[1fr_.8fr]">
        <SectionHeading eyebrow="Listen your way" title="Find us on your favourite platform." />
        <p class="m-0 max-w-xl text-[1.05rem] leading-8 text-slate-600 lg:justify-self-end">Choose video on YouTube or listen immediately with the Spotify player. Audiomack and other official profiles will be linked as soon as their URLs are confirmed.</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {platforms.map(({ icon: Icon, name, format, href, cta }) => (
          <article class="flex min-h-64 flex-col rounded-2xl border border-slate-200 p-7">
            <span class="grid size-12 place-items-center rounded-full bg-indigo text-gold-light"><Icon size={22} stroke-width={1.5} /></span>
            <h2 class="mb-0 mt-8 font-display text-2xl font-normal text-indigo">{name}</h2>
            <p class="mb-6 mt-2 text-sm text-slate-600">{format}</p>
            {href
              ? <a class="text-link mt-auto" href={href} target="_blank" rel="noreferrer">{cta} <ArrowUpRight size={15} /></a>
              : <p class="mb-0 mt-auto text-[.66rem] font-black uppercase tracking-[.12em] text-coral">{cta}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gold-light py-[clamp(4rem,8vw,6rem)] text-indigo">
    <div class="container-site flex flex-wrap items-center justify-between gap-8">
      <div>
        <p class="eyebrow !text-coral">Watch and share</p>
        <h2 class="mb-0 mt-4 font-display text-[clamp(2.3rem,4vw,4rem)] font-normal tracking-[-.04em]">Take the message with you.</h2>
        <p class="mb-0 mt-4 max-w-2xl text-indigo/70">Subscribe on YouTube and share a message with someone who needs encouragement this week.</p>
      </div>
      <a class="btn bg-indigo text-white" href={youtubeUrl} target="_blank" rel="noreferrer">
        <Video size={17} /> Visit YouTube <ArrowUpRight size={16} />
      </a>
    </div>
  </section>
  <Footer />
</BaseLayout>
