---
import {
  ArrowRight, ArrowUpRight, BookOpenCheck, Church, HandHeart, Mail, MapPin,
  Mic2, Phone, Play, Quote, Sparkles, Video, Waves
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getNewsPosts } from '../lib/sanity';

const pathways = [
  { icon: Sparkles, step: '01', title: 'Meet Jesus', copy: 'Discover the hope, peace, and new life found in Jesus Christ.', link: 'Begin here', href: '/basic-bible-beliefs/' },
  { icon: Church, step: '02', title: 'New to church?', copy: 'Know what to expect and feel at home before your first Sunday.', link: 'Find a church', href: '/#find-a-church' },
  { icon: BookOpenCheck, step: '03', title: 'What we believe', copy: 'Explore a faith grounded in the whole Bible, rightly divided.', link: 'Our beliefs', href: '/basic-bible-beliefs/' },
];

const ministries = [
  { image: '/images/ministries/sundayschool.jpg', title: 'Sunday School', copy: 'Helping every generation grow through faithful, practical teaching of God’s Word.', tone: 'bg-[#edf3ee]', url: 'https://www.thechurchofgod.org/ss/' },
  { image: '/images/ministries/vlb.jpg', title: 'Victory Leaders Band', copy: 'Discipling young people to become faithful, Spirit-filled followers of Christ.', tone: 'bg-[#f8eee9]', url: 'https://www.thechurchofgod.org/vlb/' },
  { image: '/images/ministries/wmb.jpg', title: 'Womens Missionary Band', copy: 'Equipping women to serve with compassion, courage, and a heart for missions.', tone: 'bg-[#f5f0e4]', url: 'https://www.thechurchofgod.org/wmb/' },
  { image: '/images/ministries/worldmission.jpg', title: 'World Mission', copy: 'Carrying the message of Jesus from our communities to people everywhere.', tone: 'bg-[#eaf0f6]', url: 'https://www.thechurchofgod.org/worldmission/' },
  { image: '/images/ministries/bti.jpg', title: 'Bible Training Institute', copy: 'Preparing people with biblical knowledge and practical tools for ministry.', tone: 'bg-[#f3ecf5]', url: 'https://www.thechurchofgod.org/bti/' },
  { image: '/images/ministries/evangelism.jpg', title: 'Evangelism', copy: 'Sharing redemption and grace with every culture, community, and soul.', tone: 'bg-[#eef3ee]', url: 'https://www.thechurchofgod.org/evangelism/' },
];

const events = [
  { id: 'national-convention', month: '2026', day: 'TBA', type: 'National gathering', title: 'The Church of God Nigeria National Convention', dateLabel: 'Date to be announced', place: 'Venue to be announced', description: 'The national convention will bring the Church together for worship, fellowship, ministry, and the Word. The confirmed date, venue, and programme will be published here when available.' },
  { id: 'womens-seminar', month: 'OCT', day: '03', type: 'Women in ministry', title: 'Women Missionary Fellowship Seminar', dateLabel: 'Saturday, 3 October 2026', place: 'National Office, Omuo Ekiti', venue: 'Opposite Ammunu Comprehensive High School, Omuo Ekiti, Ekiti State, Nigeria.', mapUrl: 'https://maps.app.goo.gl/F3KpTRaDfWW6TmfL9', description: 'A dedicated seminar for women to grow in the Word, strengthen fellowship, and be equipped for faithful Christian service and mission.' },
];

const branches = [
  { state: 'Ekiti', city: 'Omuo Ekiti', name: 'The Church of God — National Office', address: 'Opposite Ammunu Comprehensive High School, Omuo Ekiti, Ekiti State, Nigeria.', mapUrl: 'https://maps.app.goo.gl/F3KpTRaDfWW6TmfL9' },
  { state: 'Ondo', city: 'Oyin Akoko', name: 'The Church of God — Oyin Akoko', address: 'Oyin Akoko, Ondo State, Nigeria.', mapUrl: 'https://maps.app.goo.gl/pTBfyfQp9VhvBuqM6' },
  { state: 'Lagos', city: 'Iyana Ipaja', name: 'The Church of God — Lagos', address: '49, Olajide Street, Opposite NNPC Road, Iyana Ipaja, Lagos State, Nigeria.', mapUrl: 'https://maps.app.goo.gl/9LmyTUzsedpnThu9A' },
];

const cmsUpdates = (await getNewsPosts()).slice(0, 2).map((post) => ({
  tag: post.category ?? 'News',
  title: post.title,
  copy: post.excerpt ?? 'Read the latest update from The Church of God Nigeria.',
  href: '/news/' + post.slug + '/',
}));
const updates = cmsUpdates.length ? cmsUpdates : [
  { tag: 'From the field', title: 'Faith in action: serving our neighbours with practical love', copy: 'A sample story space for local churches to share community outreach, testimonies, and the people behind the mission.', href: '/news/' },
  { tag: 'Church life', title: 'A new season of discipleship for every generation', copy: 'Use this area for verified national updates, ministry announcements, and stories from churches across Nigeria.', href: '/news/' },
];
---

<BaseLayout title="The Church of God Nigeria | Truth & Love" description="Welcome to The Church of God Nigeria — a place to worship, grow in the Word, belong, and serve.">
  <Hero />

  <section id="new-here" class="section-space bg-white" aria-labelledby="pathway-title">
    <div class="container-site">
      <div class="grid items-end gap-8 lg:grid-cols-[1.1fr_.9fr]">
        <SectionHeading eyebrow="Start your journey" title="Wherever you are, there’s a next step." />
        <p class="m-0 max-w-xl text-[1.05rem] leading-8 text-slate-600 lg:justify-self-end">Whether you are exploring faith, returning to church, or looking for a community to call home, we would be honoured to walk with you.</p>
      </div>
      <div class="mt-12 grid border-y border-slate-200 md:grid-cols-3">
        {pathways.map(({ icon: Icon, step, title, copy, link, href }, index) => (
          <article class:list={['group relative px-0 py-9 md:px-8 md:py-12 lg:px-12', { 'border-t border-slate-200 md:border-l md:border-t-0': index > 0 }]}>
            <div class="mb-10 flex items-center justify-between"><span class="grid size-12 place-items-center rounded-full bg-indigo text-gold-light"><Icon size={22} stroke-width={1.7} /></span><span class="font-display text-sm italic text-slate-400">{step}</span></div>
            <h3 class="m-0 font-display text-[1.7rem] font-normal tracking-[-.03em] text-indigo">{title}</h3>
            <p class="mb-7 mt-3 max-w-xs leading-7 text-slate-600">{copy}</p>
            <a class="text-link" href={href}>{link} <ArrowRight size={15} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="identity" class="identity section-space overflow-hidden bg-cream" aria-labelledby="identity-title">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="relative min-h-[28rem] overflow-hidden rounded-[1.5rem] bg-indigo px-7 py-10 text-white sm:px-12 sm:py-14">
        <div class="pattern" aria-hidden="true"></div>
        <Quote class="text-gold" size={38} stroke-width={1.4} />
        <blockquote class="relative z-10 m-0 mt-12 max-w-xl font-display text-[clamp(2.25rem,5vw,4.7rem)] leading-[1.02] tracking-[-.045em]">The whole Bible,<br /><em class="text-gold-light">rightly divided.</em></blockquote>
        <p class="relative z-10 mb-0 mt-8 max-w-sm text-sm leading-7 text-white/65">The New Testament is our rule of faith, practice, government, and discipline.</p>
      </div>
      <div>
        <p class="eyebrow">Who we are</p>
        <h2 id="identity-title" class="section-title">United by<br /><em class="text-coral">truth &amp; love.</em></h2>
        <p class="mt-7 text-lg leading-8 text-slate-600">We are part of a global church family following Jesus Christ and living out His Word in the communities we call home.</p>
        <p class="mt-5 leading-8 text-slate-600">In Nigeria, our desire is simple: make disciples, strengthen families, equip the next generation, and share the full Gospel with grace and courage.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-outline-dark" href="#">Discover our story</a><a class="text-link px-3" href="#">Read our beliefs <ArrowRight size={15} /></a></div>
      </div>
    </div>
  </section>

  <section id="find-a-church" class="relative isolate overflow-hidden bg-indigo py-[clamp(4rem,8vw,7rem)] text-white" aria-labelledby="finder-title">
    <div class="finder-pattern" aria-hidden="true"></div>
    <div class="container-site relative z-10 grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
      <div>
        <p class="eyebrow !text-gold-light">Find your church family</p>
        <h2 id="finder-title" class="mt-4 font-display text-[clamp(2.6rem,5vw,5rem)] font-normal leading-[.98] tracking-[-.045em]">A community<br />closer than you think.</h2>
        <p class="mb-0 mt-6 max-w-lg text-lg leading-8 text-white/70">Search for a Church of God congregation near you and find service details, directions, and a warm welcome.</p>
      </div>
      <form id="branch-finder-form" class="rounded-3xl bg-white p-5 text-ink shadow-2xl shadow-black/20 sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-xs font-extrabold uppercase tracking-[.09em] text-indigo">State
            <select class="min-h-14 rounded-xl border border-slate-200 bg-white px-4 text-base font-normal normal-case tracking-normal text-slate-700" name="state"><option value="">Choose a state</option><option>Ekiti</option><option>Lagos</option><option>Ondo</option></select>
          </label>
          <label class="grid gap-2 text-xs font-extrabold uppercase tracking-[.09em] text-indigo">Town or city
            <input class="min-h-14 rounded-xl border border-slate-200 px-4 text-base font-normal normal-case tracking-normal placeholder:text-slate-400" type="search" name="city" placeholder="e.g. Omuo Ekiti" />
          </label>
        </div>
        <button class="btn btn-primary mt-5 w-full border-0" type="submit"><MapPin size={17} /> Search churches</button>
        <p class="mb-0 mt-4 text-center text-xs leading-5 text-slate-500">Search by state or town, or leave both fields blank to view every branch.</p>
      </form>
    </div>
    <dialog id="branch-results" class="m-auto max-h-[88vh] w-[min(94vw,58rem)] overflow-y-auto rounded-3xl border-0 bg-white p-0 text-ink shadow-2xl" aria-labelledby="branch-results-title">
      <div class="sticky top-0 z-10 flex items-start justify-between gap-6 border-b border-slate-200 bg-white p-6 sm:p-8"><div><p class="mb-0 text-[.68rem] font-black uppercase tracking-[.14em] text-coral">Church directory</p><h2 id="branch-results-title" class="mb-0 mt-2 font-display text-[clamp(2rem,5vw,3.4rem)] font-normal leading-none tracking-[-.04em] text-indigo">Find your church family.</h2><p id="branch-results-summary" class="mb-0 mt-3 text-sm text-slate-500" aria-live="polite"></p><p class="mb-0 mt-1 text-xs leading-5 text-slate-400">National-office contact details are shown until branch-specific contacts are supplied.</p></div><button id="branch-results-close" class="grid size-10 shrink-0 place-items-center rounded-full border border-slate-200 bg-white text-xl leading-none text-indigo hover:bg-mist" type="button" aria-label="Close church directory">×</button></div>
      <div class="grid gap-4 p-6 sm:p-8">
        {branches.map((branch) => (
          <article class="branch-card rounded-2xl border border-slate-200 p-5 sm:p-6" data-state={branch.state.toLowerCase()} data-search={`${branch.name} ${branch.city} ${branch.address}`.toLowerCase()}>
            <div class="flex flex-wrap items-start justify-between gap-4"><div><p class="mb-0 text-[.65rem] font-black uppercase tracking-[.13em] text-leaf">{branch.state} State</p><h3 class="mb-0 mt-2 font-display text-2xl font-normal tracking-[-.025em] text-indigo">{branch.name}</h3></div><span class:list={['rounded-full px-3 py-1 text-[.62rem] font-black uppercase tracking-[.1em]', branch.mapUrl ? 'bg-[#edf3ee] text-leaf' : 'bg-cream text-coral']}>{branch.mapUrl ? 'Location confirmed' : 'Address pending'}</span></div>
            <p class="mb-0 mt-4 flex items-start gap-2 text-sm leading-6 text-slate-600"><MapPin class="mt-1 shrink-0 text-coral" size={16} /> {branch.address}</p>
            <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-slate-100 pt-5 text-sm"><a class="inline-flex items-center gap-2 text-indigo no-underline hover:text-coral" href="tel:+2348063035886"><Phone size={15} /> +234 806 303 5886</a><a class="inline-flex items-center gap-2 text-indigo no-underline hover:text-coral" href="mailto:Info@tcog.org.ng"><Mail size={15} /> Info@tcog.org.ng</a></div>
            {branch.mapUrl ? <a class="btn btn-primary mt-6" href={branch.mapUrl} target="_blank" rel="noreferrer"><MapPin size={16} /> Get directions <ArrowUpRight size={15} /></a> : <a class="btn btn-outline-dark mt-6" href="mailto:Info@tcog.org.ng?subject=Lagos%20branch%20directions"><Mail size={16} /> Ask for directions</a>}
          </article>
        ))}
        <div id="branch-no-results" class="rounded-2xl bg-cream p-8 text-center" hidden><h3 class="m-0 font-display text-2xl font-normal text-indigo">No matching branch found.</h3><p class="mb-0 mt-3 text-sm leading-6 text-slate-600">Try another town or contact the national office at <a class="text-indigo" href="mailto:Info@tcog.org.ng">Info@tcog.org.ng</a>.</p></div>
      </div>
    </dialog>
  </section>

  <section id="ministries" class="section-space bg-white" aria-labelledby="ministries-title">
    <div class="container-site">
      <div class="grid items-end gap-8 lg:grid-cols-[1fr_auto]">
        <SectionHeading eyebrow="How we serve" title="Faith for every season of life." copy="Ministries that help children, young people, women, families, leaders, and local churches grow and serve together." />
        <a class="btn btn-outline-dark w-fit" href="/ministries/">View all ministries <ArrowRight size={16} /></a>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {ministries.map(({ image, title, copy, tone, url }) => (
          <article class:list={['group flex flex-col rounded-2xl p-5 transition-transform duration-300 hover:-translate-y-1 sm:p-6', tone]}>
            <div class="overflow-hidden rounded-xl bg-white shadow-sm"><img src={image} alt={`${title} official ministry branding`} loading="lazy" width="400" height="300" class="aspect-[4/3] w-full object-cover" /></div>
            <h3 class="mb-0 mt-7 font-display text-[1.6rem] font-normal tracking-[-.025em] text-indigo">{title}</h3>
            <p class="mb-7 mt-3 leading-7 text-slate-600">{copy}</p>
            <a class="text-link mt-auto" href={url} target="_blank" rel="noreferrer" aria-label={`Visit the international ${title} page`}>Learn more <ArrowUpRight size={15} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="media" class="section-space bg-mist" aria-labelledby="media-title">
    <div class="container-site">
      <SectionHeading eyebrow="Watch & listen" title="A word for the week ahead." copy="Messages, worship moments, and conversations to help you grow wherever you are." />
      <div class="mt-12 grid overflow-hidden rounded-3xl bg-indigo text-white lg:grid-cols-[1.25fr_.75fr]">
        <div class="media-visual relative min-h-[24rem] overflow-hidden sm:min-h-[31rem]">
          <img src="/images/nigeria-worship-hero.webp" alt="Nigerian church members worshipping during a service" loading="lazy" width="1792" height="896" class="absolute inset-0 h-full w-full object-cover object-center opacity-80" />
          <div class="absolute inset-0 bg-gradient-to-t from-indigo via-transparent to-transparent"></div>
          <a href="https://www.youtube.com/@TCOGNG" target="_blank" rel="noreferrer" class="absolute inset-0 grid place-items-center" aria-label="Watch messages on The Church of God Nigeria YouTube channel"><span class="grid size-20 place-items-center rounded-full bg-white text-indigo shadow-xl transition-transform hover:scale-105"><Play size={26} fill="currentColor" /></span></a>
          <span class="absolute bottom-6 left-6 rounded-full bg-white/15 px-4 py-2 text-[.68rem] font-black uppercase tracking-[.12em] backdrop-blur-md">Messages on YouTube</span>
        </div>
        <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-14">
          <p class="mb-0 flex items-center gap-2 text-xs font-black uppercase tracking-[.12em] text-gold-light"><Mic2 size={15} /> Sunday message</p>
          <h3 class="mb-0 mt-5 font-display text-[clamp(2.2rem,4vw,4rem)] font-normal leading-[1.03] tracking-[-.04em]">Messages for everyday faith.</h3>
          <p class="mt-5 leading-8 text-white/68">Watch sermons and teaching from The Church of God Nigeria, or continue to the media page to listen on Spotify.</p>
          <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="https://www.youtube.com/@TCOGNG" target="_blank" rel="noreferrer"><Play size={16} /> Watch now</a><a class="btn btn-outline-light" href="/media/"><Video size={17} /> Media library</a></div>
        </div>
      </div>
    </div>
  </section>

  <section id="events" class="section-space bg-white" aria-labelledby="events-title">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-8"><SectionHeading eyebrow="Come together" title="Upcoming gatherings." copy="Moments for worship, encouragement, learning, and fellowship with the wider church family." /><a class="text-link mb-2" href="#">See all events <ArrowRight size={15} /></a></div>
      <div class="mt-12 border-t border-slate-200">
        {events.map((event) => (
          <article class="grid gap-5 border-b border-slate-200 py-7 transition-colors hover:bg-cream sm:grid-cols-[7rem_1fr_auto] sm:items-center sm:px-5">
            <div class="flex items-center gap-3 sm:grid sm:gap-0"><strong class="font-display text-3xl font-normal text-coral">{event.day}</strong><span class="text-[.65rem] font-black uppercase tracking-[.15em] text-slate-400">{event.month}</span></div>
            <div><p class="m-0 text-[.66rem] font-black uppercase tracking-[.13em] text-leaf">{event.type}</p><h3 class="mb-0 mt-1 font-display text-[1.45rem] font-normal tracking-[-.02em] text-indigo">{event.title}</h3><p class="mb-0 mt-1 flex items-center gap-2 text-sm text-slate-500"><MapPin size={14} /> {event.place}</p></div>
            <button class="text-link w-fit border-0 bg-transparent p-0" type="button" data-event-id={event.id} aria-haspopup="dialog">Event details <ArrowRight size={15} /></button>
          </article>
        ))}
      </div>
      {events.map((event) => (
        <dialog id={`event-${event.id}`} data-event-dialog class="m-auto w-[min(92vw,42rem)] overflow-hidden rounded-3xl border-0 bg-white p-0 text-ink shadow-2xl" aria-labelledby={`event-title-${event.id}`}>
          <div class="border-t-[6px] border-coral p-6 sm:p-9">
            <div class="flex items-start justify-between gap-5"><p class="mb-0 text-[.68rem] font-black uppercase tracking-[.14em] text-coral">{event.type}</p><button class="event-close grid size-10 shrink-0 place-items-center rounded-full border border-slate-200 bg-white text-xl leading-none text-indigo hover:bg-mist" type="button" aria-label="Close event details">×</button></div>
            <h3 id={`event-title-${event.id}`} class="mb-0 mt-5 font-display text-[clamp(2rem,5vw,3.3rem)] font-normal leading-[1.05] tracking-[-.04em] text-indigo">{event.title}</h3>
            <dl class="mt-8 grid gap-5 rounded-2xl bg-cream p-5 sm:grid-cols-2 sm:p-6"><div><dt class="text-[.65rem] font-black uppercase tracking-[.13em] text-leaf">Date</dt><dd class="mb-0 mt-2 font-semibold text-indigo">{event.dateLabel}</dd></div><div><dt class="text-[.65rem] font-black uppercase tracking-[.13em] text-leaf">Venue</dt><dd class="mb-0 mt-2 font-semibold text-indigo">{event.venue ?? event.place}</dd></div></dl>
            <p class="mb-0 mt-7 leading-8 text-slate-600">{event.description}</p>
            {event.mapUrl && <a class="btn btn-primary mt-8" href={event.mapUrl} target="_blank" rel="noreferrer"><MapPin size={17} /> Open venue in Google Maps <ArrowUpRight size={16} /></a>}
          </div>
        </dialog>
      ))}
    </div>
  </section>

  <section id="news" class="section-space bg-cream" aria-labelledby="news-title">
    <div class="container-site grid gap-14 lg:grid-cols-[.75fr_1.25fr] lg:gap-20">
      <div>
        <SectionHeading eyebrow="The mission in motion" title="Good news from across the Church." copy="Share verified stories of changed lives, faithful service, and churches making Christ known in their communities." />
        <a class="btn btn-outline-dark mt-8" href="/news/">More news &amp; stories</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {updates.map((update, index) => (
          <article class="flex min-h-[27rem] flex-col justify-end overflow-hidden rounded-2xl bg-white p-7 shadow-sm sm:p-9">
            <div class:list={['mb-auto grid size-14 place-items-center rounded-full', index === 0 ? 'bg-leaf text-white' : 'bg-coral text-white']}><Waves size={24} stroke-width={1.5} /></div>
            <p class="mb-0 text-[.68rem] font-black uppercase tracking-[.14em] text-coral">{update.tag}</p>
            <h3 class="mb-0 mt-3 font-display text-[1.75rem] font-normal leading-[1.12] tracking-[-.025em] text-indigo">{update.title}</h3>
            <p class="mb-6 mt-4 text-sm leading-7 text-slate-600">{update.copy}</p>
            <a class="text-link" href={update.href}>Read story <ArrowRight size={15} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-[clamp(4rem,8vw,7rem)]">
    <div class="container-site grid gap-5 lg:grid-cols-2">
      <article id="prayer" class="prayer-card relative isolate overflow-hidden rounded-3xl bg-indigo p-8 text-white sm:p-12">
        <HandHeart class="text-gold-light" size={40} stroke-width={1.4} />
        <p class="eyebrow mt-12 !text-gold-light">We are here for you</p>
        <h2 class="mb-0 mt-4 font-display text-[clamp(2.3rem,4vw,3.8rem)] font-normal leading-[1] tracking-[-.04em]">How can we pray with you?</h2>
        <p class="mb-8 mt-5 max-w-lg leading-8 text-white/70">Share what is on your heart. Your request will be treated with care and received by the prayer team.</p>
        <a class="btn btn-light" href="/#prayer" data-prayer-open>Share a prayer request <ArrowRight size={16} /></a>
      </article>
      <article id="giving" class="relative overflow-hidden rounded-3xl bg-gold-light p-8 text-indigo sm:p-12">
        <HandHeart size={40} stroke-width={1.4} />
        <p class="eyebrow mt-12 !text-coral">Generosity in action</p>
        <h2 class="mb-0 mt-4 font-display text-[clamp(2.3rem,4vw,3.8rem)] font-normal leading-[1] tracking-[-.04em]">Give with purpose.</h2>
        <p class="mb-8 mt-5 max-w-lg leading-8 text-indigo/70">Support ministry, discipleship, missions, and practical care through secure giving.</p>
        <a class="btn bg-indigo text-white hover:bg-indigo-light" href="https://www.thechurchofgod.org/give/" target="_blank" rel="noreferrer">Ways to give <ArrowUpRight size={16} /></a>
      </article>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .pattern { position:absolute; inset:-15%; opacity:.24; background-image:linear-gradient(45deg, transparent 44%, #d10a20 45%, #d10a20 47%, transparent 48%), linear-gradient(-45deg, transparent 44%, #a22b8c 45%, #a22b8c 47%, transparent 48%); background-size:58px 58px; transform:rotate(8deg); }
  .finder-pattern { position:absolute; inset:0; opacity:.14; background-image:radial-gradient(circle at 20% 40%, #f3c2e1 0 2px, transparent 3px), radial-gradient(circle at 75% 30%, #fff 0 1px, transparent 2px); background-size:70px 70px, 43px 43px; mask-image:linear-gradient(90deg, transparent, #000 40%, #000); }
  .prayer-card::after { position:absolute; z-index:-1; width:24rem; height:24rem; right:-8rem; bottom:-11rem; border:1px solid rgb(241 213 139 / .25); border-radius:50%; box-shadow:0 0 0 3rem rgb(241 213 139 / .07), 0 0 0 6rem rgb(241 213 139 / .04); content:""; }
  dialog::backdrop { background:rgb(5 16 51 / .76); backdrop-filter:blur(5px); }
  dialog[open] { animation:event-in .2s ease-out; }
  @keyframes event-in { from { opacity:0; transform:translateY(1rem) scale(.98); } to { opacity:1; transform:none; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-event-id]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const dialog = document.querySelector<HTMLDialogElement>(`#event-${trigger.dataset.eventId}`);
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('[data-event-dialog]').forEach((dialog) => {
    dialog.querySelector<HTMLButtonElement>('.event-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });

  const finderForm = document.querySelector<HTMLFormElement>('#branch-finder-form');
  const branchDialog = document.querySelector<HTMLDialogElement>('#branch-results');
  const branchSummary = document.querySelector<HTMLElement>('#branch-results-summary');
  const noResults = document.querySelector<HTMLElement>('#branch-no-results');
  const branchCards = [...document.querySelectorAll<HTMLElement>('.branch-card')];

  finderForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(finderForm);
    const state = String(data.get('state') ?? '').trim().toLowerCase();
    const city = String(data.get('city') ?? '').trim().toLowerCase();
    let matches = 0;
    branchCards.forEach((card) => {
      const matchesState = !state || card.dataset.state === state;
      const matchesCity = !city || card.dataset.search?.includes(city);
      const visible = matchesState && Boolean(matchesCity);
      card.hidden = !visible;
      if (visible) matches += 1;
    });
    if (branchSummary) branchSummary.textContent = matches === 1 ? 'Showing 1 matching branch.' : `Showing ${matches} matching branches.`;
    if (noResults) noResults.hidden = matches > 0;
    branchDialog?.showModal();
  });
  document.querySelector<HTMLButtonElement>('#branch-results-close')?.addEventListener('click', () => branchDialog?.close());
  branchDialog?.addEventListener('click', (event) => { if (event.target === branchDialog) branchDialog.close(); });
</script>
