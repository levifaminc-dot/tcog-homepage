---
import { ArrowRight, ArrowUpRight, BookOpenCheck, CalendarDays, Church, Flame, HeartHandshake, MapPin, Quote, ShieldCheck } from '@lucide/astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import bishopOgunmola from '../assets/leadership/bishop-ogunmola.png';
import toyinBakare from '../assets/leadership/toyin-bakare.jpg';
import abeAdeGabriel from '../assets/leadership/abe-ade-gabriel.jpg';

const values = [
  { icon: Church, title: 'Jesus-centred', copy: 'Jesus Christ is the foundation of our faith, our message, and our life together.' },
  { icon: BookOpenCheck, title: 'Bible-grounded', copy: 'We accept the whole Bible, rightly divided, with the New Testament as our rule of faith and practice.' },
  { icon: Flame, title: 'Spirit-led', copy: 'We depend on the Holy Spirit to shape holy lives and empower faithful service.' },
  { icon: HeartHandshake, title: 'Mission-minded', copy: 'We make disciples, strengthen families, and share the Gospel in word and action.' },
];

const beliefs = [
  'The authority and inspiration of Holy Scripture',
  'Salvation through Jesus Christ',
  'A life of holiness and faithful discipleship',
  'The present work and gifts of the Holy Spirit',
  'The unity, mission, and fellowship of the Church',
  'The return of Jesus Christ and the hope of resurrection',
];

const leaders = [
  { image: bishopOgunmola, role: 'National Overseer', name: 'Bishop Ogunmola Matthew', position: 'object-center' },
  { image: toyinBakare, role: 'National Secretary', name: 'Sis. Toyin Bakare', position: 'object-center' },
  { image: abeAdeGabriel, role: 'Field Secretary', name: 'Bro. (Dr.) Abe Ade Gabriel', position: 'object-center' },
];
---
<BaseLayout title="About | The Church of God Nigeria" description="Learn who we are, what we believe, and how The Church of God Nigeria follows Jesus in truth and love.">
  <PageHero eyebrow="About the Church" title="One faith. One family. One mission." copy="We are part of a global, growing church family united by God’s Word and called to make the hope of Jesus known throughout Nigeria." image="/images/church-life/church-leadership-gathering.webp" imageAlt="A Church of God gathering at the pulpit, with the church flag visible" imagePosition="center 44%" />

  <section id="page-content" class="section-space bg-white">
    <div class="container-site grid items-start gap-14 lg:grid-cols-[.8fr_1.2fr] lg:gap-24">
      <div><p class="eyebrow">Who we are</p><h2 class="section-title">Following Jesus.<br /><em class="text-coral">Together.</em></h2></div>
      <div class="max-w-3xl text-[1.08rem] leading-8 text-slate-600">
        <p class="mt-0">The Church of God is a global Body of Christ with members united in a covenant to walk in the light of God’s Word. In Nigeria, this means building welcoming local churches where people can worship, learn, belong, and serve.</p>
        <p>Our mission begins in the communities around us and reaches outward: sharing the full Gospel, making disciples, developing leaders, and laying a faithful foundation for the next generation.</p>
        <a class="text-link mt-4" href="/#find-a-church">Meet a local church <ArrowRight size={15} /></a>
      </div>
    </div>
  </section>

  <section class="section-space bg-cream">
    <div class="container-site">
      <SectionHeading eyebrow="Our character" title="What shapes our life together." copy="These convictions guide the way we worship, teach, care for people, and serve our communities." />
      <div class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-slate-200 sm:grid-cols-2 lg:grid-cols-4">
        {values.map(({ icon: Icon, title, copy }) => <article class="bg-white p-8 sm:p-9"><span class="grid size-12 place-items-center rounded-full bg-indigo text-gold-light"><Icon size={22} stroke-width={1.6} /></span><h3 class="mb-0 mt-9 font-display text-2xl font-normal text-indigo">{title}</h3><p class="mb-0 mt-3 text-sm leading-7 text-slate-600">{copy}</p></article>)}
      </div>
    </div>
  </section>

  <section id="beliefs" class="section-space bg-indigo text-white">
    <div class="container-site grid gap-14 lg:grid-cols-[.85fr_1.15fr] lg:gap-24">
      <div><Quote class="text-gold" size={36} stroke-width={1.4} /><p class="mt-10 font-display text-[clamp(2.5rem,5vw,4.8rem)] leading-[1.02] tracking-[-.045em]">The whole Bible,<br /><em class="text-gold-light">rightly divided.</em></p><p class="max-w-md leading-8 text-white/65">Our full statement of faith will be published here after national leadership review.</p></div>
      <div><p class="eyebrow !text-gold-light">What we believe</p><h2 class="mt-4 font-display text-[clamp(2.2rem,4vw,3.8rem)] font-normal leading-[1.05] tracking-[-.04em]">A faith to know,<br />live, and share.</h2><div class="mt-9 grid gap-3">{beliefs.map((belief) => <div class="flex items-start gap-4 border-b border-white/12 py-4"><ShieldCheck class="mt-1 shrink-0 text-gold" size={20} /><span class="text-white/78">{belief}</span></div>)}</div><a class="btn btn-light mt-8" href="/basic-bible-beliefs/">Read our basic Bible beliefs <ArrowRight size={16} /></a></div>
    </div>
  </section>

  <section id="story" class="section-space bg-white">
    <div class="container-site">
      <div class="grid items-end gap-8 lg:grid-cols-[1.05fr_.95fr]"><SectionHeading eyebrow="Our story in Nigeria" title="Established in faith. Growing in service." /><p class="m-0 max-w-xl text-[1.08rem] leading-8 text-slate-600 lg:justify-self-end">The Church of God was officially established in Nigeria in 1992. From that beginning, the work has continued through local congregations, faithful leadership, and a shared commitment to the whole Bible, rightly divided.</p></div>
      <div class="mt-14 grid overflow-hidden rounded-3xl border border-slate-200 lg:grid-cols-2">
        <article class="relative min-h-[24rem] overflow-hidden bg-indigo p-8 text-white sm:p-12"><div class="absolute -right-20 -top-20 size-80 rounded-full border-[4rem] border-gold/15"></div><CalendarDays class="relative text-gold-light" size={42} stroke-width={1.4} /><p class="relative mb-0 mt-16 text-[.68rem] font-black uppercase tracking-[.16em] text-gold-light">A defining year</p><p class="relative mb-0 mt-3 font-display text-[clamp(4.5rem,10vw,8rem)] leading-none tracking-[-.06em]">1992</p><p class="relative mb-0 mt-6 max-w-md leading-8 text-white/70">The year The Church of God was officially established in Nigeria.</p></article>
        <article class="flex min-h-[24rem] flex-col bg-cream p-8 sm:p-12"><MapPin class="text-coral" size={42} stroke-width={1.4} /><p class="eyebrow mt-16">National office</p><h3 class="mb-0 mt-3 font-display text-[clamp(2rem,4vw,3.4rem)] font-normal leading-[1.05] tracking-[-.04em] text-indigo">Omuo Ekiti,<br />Ekiti State.</h3><address class="mb-8 mt-5 max-w-md not-italic leading-8 text-slate-600">Opposite Ammunu Comprehensive High School, Omuo Ekiti, Ekiti State, Nigeria.</address><a class="text-link mt-auto" href="https://maps.app.goo.gl/F3KpTRaDfWW6TmfL9" target="_blank" rel="noreferrer">Open in Google Maps <ArrowUpRight size={16} /></a></article>
      </div>
    </div>
  </section>

  <section id="leadership" class="section-space bg-cream">
    <div class="container-site"><SectionHeading align="center" eyebrow="National leadership" title="Serving with faithfulness." copy="Meet the leaders entrusted with serving and supporting The Church of God across Nigeria." /><div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">{leaders.map((leader) => <article class="overflow-hidden rounded-2xl bg-white text-center shadow-sm"><div class="overflow-hidden bg-indigo"><Image src={leader.image} alt={leader.name} width={720} format="webp" quality={78} loading="lazy" class:list={['h-72 w-full object-cover', leader.position]} /></div><div class="p-7"><p class="m-0 text-[.66rem] font-black uppercase tracking-[.14em] text-coral">{leader.role}</p><h3 class="mb-0 mt-3 font-display text-[1.55rem] font-normal leading-tight tracking-[-.025em] text-indigo">{leader.name}</h3></div></article>)}</div></div>
  </section>
  <Footer />
</BaseLayout>
