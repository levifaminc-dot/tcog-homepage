---
import { HandHeart, Mail, Send } from '@lucide/astro';
---

<dialog id="prayer-request-dialog" class="prayer-dialog" aria-labelledby="prayer-dialog-title">
  <div class="prayer-shell">
    <div class="prayer-intro">
      <HandHeart size={38} stroke-width={1.4} />
      <p class="prayer-eyebrow">Confidential prayer request</p>
      <h2 id="prayer-dialog-title">How can we pray with you?</h2>
      <p>Your request will be emailed to the national prayer team at <strong>Info@tcog.org.ng</strong> and treated with care.</p>
    </div>

    <form id="prayer-request-form" class="prayer-form" action="https://formsubmit.co/ajax/Info@tcog.org.ng" method="POST">
      <button class="prayer-close" type="button" aria-label="Close prayer request form">×</button>
      <input type="hidden" name="_subject" value="New prayer request from tcog.org.ng" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <label class="prayer-honey" aria-hidden="true">Leave this field empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>

      <div class="prayer-fields">
        <label>Full name
          <input name="Name" type="text" autocomplete="name" required />
        </label>
        <label>Email address
          <input name="Email" type="email" autocomplete="email" required />
        </label>
        <label>Phone number <span>(optional)</span>
          <input name="Phone" type="tel" autocomplete="tel" />
        </label>
        <label>State or location <span>(optional)</span>
          <input name="Location" type="text" autocomplete="address-level1" />
        </label>
        <label class="prayer-message">Prayer request
          <textarea name="Prayer request" rows="6" required placeholder="Share only what you are comfortable telling us."></textarea>
        </label>
      </div>

      <label class="prayer-consent"><input name="Consent" type="checkbox" value="Yes" required /><span>I consent to this information being emailed to The Church of God Nigeria prayer team.</span></label>
      <p id="prayer-form-status" class="prayer-status" role="status" aria-live="polite"></p>
      <button class="btn btn-primary prayer-submit" type="submit"><Send size={16} /> Send prayer request</button>
      <a class="prayer-email-fallback" href="mailto:Info@tcog.org.ng?subject=Prayer%20request"><Mail size={15} /> Or email the prayer team directly</a>
    </form>
  </div>
</dialog>

<script>
  const prayerDialog = document.querySelector<HTMLDialogElement>('#prayer-request-dialog');
  const prayerForm = document.querySelector<HTMLFormElement>('#prayer-request-form');
  const prayerStatus = document.querySelector<HTMLElement>('#prayer-form-status');
  const prayerSubmit = prayerForm?.querySelector<HTMLButtonElement>('.prayer-submit');

  document.querySelectorAll<HTMLElement>('[data-prayer-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      prayerDialog?.showModal();
    });
  });

  prayerDialog?.querySelector<HTMLButtonElement>('.prayer-close')?.addEventListener('click', () => prayerDialog.close());
  prayerDialog?.addEventListener('click', (event) => {
    if (event.target === prayerDialog) prayerDialog.close();
  });

  prayerForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!prayerForm.reportValidity()) return;
    if (prayerStatus) prayerStatus.textContent = 'Sending your request…';
    if (prayerSubmit) prayerSubmit.disabled = true;

    try {
      const response = await fetch(prayerForm.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(prayerForm),
      });
      if (!response.ok) throw new Error('Submission failed');
      prayerForm.reset();
      if (prayerStatus) prayerStatus.textContent = 'Thank you. Your prayer request has been submitted to the prayer team.';
    } catch {
      if (prayerStatus) prayerStatus.textContent = 'We could not send your request just now. Please use the email link below to contact the prayer team.';
    } finally {
      if (prayerSubmit) prayerSubmit.disabled = false;
    }
  });
</script>

<style>
  .prayer-dialog { width:min(94vw, 62rem); max-height:92vh; margin:auto; overflow:auto; border:0; border-radius:1.5rem; padding:0; background:#fff; color:#13172d; box-shadow:0 2rem 5rem rgb(5 16 51 / .35); }
  .prayer-dialog::backdrop { background:rgb(5 16 51 / .78); backdrop-filter:blur(5px); }
  .prayer-dialog[open] { animation:prayer-in .2s ease-out; }
  .prayer-shell { display:grid; }
  .prayer-intro { position:relative; overflow:hidden; background:#12388b; color:#fff; padding:2rem; }
  .prayer-intro::after { position:absolute; width:18rem; height:18rem; right:-8rem; bottom:-9rem; border:1px solid rgb(243 194 225 / .3); border-radius:50%; box-shadow:0 0 0 2.5rem rgb(243 194 225 / .08), 0 0 0 5rem rgb(243 194 225 / .04); content:""; }
  .prayer-intro > * { position:relative; z-index:1; }
  .prayer-intro > svg { color:#f3c2e1; }
  .prayer-eyebrow { margin:3rem 0 0; color:#f3c2e1; font-size:.72rem; font-weight:900; letter-spacing:.14em; text-transform:uppercase; }
  .prayer-intro h2 { margin:.75rem 0 0; font-family:Georgia, Cambria, serif; font-size:clamp(2.25rem, 5vw, 4rem); font-weight:400; letter-spacing:-.04em; line-height:1; }
  .prayer-intro p:last-child { max-width:28rem; margin:1.25rem 0 0; color:rgb(255 255 255 / .72); line-height:1.75; }
  .prayer-intro strong { color:#fff; }
  .prayer-form { position:relative; padding:2rem; }
  .prayer-close { position:absolute; top:1rem; right:1rem; display:grid; width:2.6rem; height:2.6rem; place-items:center; border:1px solid #dbe2ef; border-radius:50%; background:#fff; color:#12388b; font-size:1.4rem; line-height:1; cursor:pointer; }
  .prayer-fields { display:grid; gap:1rem; padding-top:2.5rem; }
  .prayer-fields label { display:grid; gap:.45rem; color:#12388b; font-size:.75rem; font-weight:900; letter-spacing:.06em; text-transform:uppercase; }
  .prayer-fields label span { color:#718096; font-size:.68rem; font-weight:600; letter-spacing:0; text-transform:none; }
  .prayer-fields input, .prayer-fields textarea { width:100%; box-sizing:border-box; border:1px solid #dbe2ef; border-radius:.8rem; background:#fff; color:#13172d; padding:.85rem 1rem; font:inherit; font-size:1rem; font-weight:400; letter-spacing:0; line-height:1.5; text-transform:none; }
  .prayer-fields textarea { min-height:9rem; resize:vertical; }
  .prayer-fields input:focus, .prayer-fields textarea:focus { border-color:#12388b; outline:3px solid rgb(18 56 139 / .12); }
  .prayer-message { grid-column:1 / -1; }
  .prayer-consent { display:flex; align-items:flex-start; gap:.7rem; margin-top:1rem; color:#526075; font-size:.78rem; line-height:1.5; }
  .prayer-consent input { flex:0 0 auto; width:1rem; height:1rem; margin-top:.2rem; accent-color:#12388b; }
  .prayer-status { min-height:1.5rem; margin:.8rem 0 0; color:#2857a7; font-size:.82rem; font-weight:700; line-height:1.5; }
  .prayer-submit { width:100%; border:0; cursor:pointer; }
  .prayer-submit:disabled { opacity:.65; cursor:wait; transform:none; }
  .prayer-email-fallback { display:flex; align-items:center; justify-content:center; gap:.45rem; margin-top:1rem; color:#12388b; font-size:.78rem; font-weight:800; text-decoration:none; }
  .prayer-honey { position:absolute !important; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  @keyframes prayer-in { from { opacity:0; transform:translateY(1rem) scale(.98); } to { opacity:1; transform:none; } }
  @media (min-width:48rem) { .prayer-shell { grid-template-columns:.8fr 1.2fr; } .prayer-intro, .prayer-form { padding:2.75rem; } .prayer-fields { grid-template-columns:1fr 1fr; padding-top:1.25rem; } }
</style>
