---
import { ArrowUpRight, Headphones, Mail, MapPin, Music2, Phone, Video } from '@lucide/astro';
import Brand from './Brand.astro';
const groups = [
  { title: 'Explore', links: [{ label:'About us', href:'/about/' }, { label:'What we believe', href:'/basic-bible-beliefs/' }, { label:'Leadership', href:'/about/#leadership' }, { label:'Our story', href:'/about/#story' }] },
  { title: 'Get involved', links: [{ label:'Find a church', href:'/#find-a-church' }, { label:'Ministries', href:'/ministries/' }, { label:'Events', href:'/#events' }, { label:'Serve', href:'/ministries/#serve' }] },
  { title: 'Stay connected', links: [{ label:'Messages', href:'/media/' }, { label:'News & stories', href:'/news/' }, { label:'Prayer request', href:'/#prayer', prayer:true }, { label:'Give', href:'https://www.thechurchofgod.org/give/', external:true }] },
];
---
<footer>
  <div class="container-site footer-grid">
    <div class="intro">
      <Brand light />
      <p>A welcoming church family growing in truth, sharing Christ’s love, and serving communities across Nigeria.</p>
      <div class="social" aria-label="Social media links">
        <a href="https://www.youtube.com/@TCOGNG" target="_blank" rel="noreferrer" aria-label="The Church of God Nigeria on YouTube"><Video size={19} /></a><a href="https://open.spotify.com/show/4VhUIGffgIffcn9fHXNFrl" target="_blank" rel="noreferrer" aria-label="The Church of God Nigeria on Spotify"><Headphones size={18} /></a><a href="https://music.youtube.com/playlist?list=PL5Z7JlunMnE6JJ5M_3wU9MwVFLFKblFDH" target="_blank" rel="noreferrer" aria-label="The Church of God Nigeria on YouTube Music"><Music2 size={18} /></a>
      </div>
    </div>
    {groups.map((group) => <nav aria-label={group.title}><h2>{group.title}</h2>{group.links.map((link) => <a href={link.href} data-prayer-open={link.prayer ? '' : undefined} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>)}</nav>)}
    <div class="contact"><h2>National office</h2><a href="https://maps.app.goo.gl/F3KpTRaDfWW6TmfL9" target="_blank" rel="noreferrer"><MapPin size={16} /><span>The Church of God, Opposite Ammunu Comprehensive High School, Omuo Ekiti, Ekiti State, Nigeria.</span></a><a href="tel:+2348063035886"><Phone size={16} /> +234 806 303 5886</a><a href="mailto:Info@tcog.org.ng"><Mail size={16} /> Info@tcog.org.ng</a><a href="https://www.thechurchofgod.org/" target="_blank" rel="noreferrer">International Offices <ArrowUpRight size={15} /></a></div>
  </div>
  <div class="container-site legal"><p>© {new Date().getFullYear()} The Church of God Nigeria. All rights reserved.</p><div><a href="#">Privacy</a><a href="#">Terms</a><a href="#">Accessibility</a></div></div>
</footer>
<style>
  footer { background:#071c52; color:#fff; padding-top:clamp(4rem, 8vw, 7rem); }
  .footer-grid { display:grid; grid-template-columns:1fr; gap:2.5rem; padding-bottom:4rem; }
  .intro { max-width:22rem; }
  .intro p { margin:1.4rem 0; color:rgb(255 255 255 / .62); font-size:.92rem; line-height:1.7; }
  .social { display:flex; gap:.55rem; }
  .social a { display:grid; width:2.55rem; height:2.55rem; place-items:center; border:1px solid rgb(255 255 255 / .2); border-radius:50%; color:#fff; }
  h2 { margin:0 0 1rem; color:#f3c2e1; font-size:.7rem; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
  nav, .contact { display:flex; flex-direction:column; align-items:flex-start; }
  nav a, .contact a { margin:.25rem 0; color:rgb(255 255 255 / .72); font-size:.86rem; text-decoration:none; }
  nav a:hover, .contact a:hover { color:#fff; }
  .contact p, .contact a { display:flex; align-items:flex-start; gap:.55rem; }
  .contact p { margin:.2rem 0 .7rem; color:rgb(255 255 255 / .58); font-size:.86rem; line-height:1.5; }
  .legal { display:flex; flex-wrap:wrap; justify-content:space-between; gap:1rem; border-top:1px solid rgb(255 255 255 / .11); padding-block:1.25rem; color:rgb(255 255 255 / .42); font-size:.7rem; }
  .legal p { margin:0; }
  .legal div { display:flex; gap:1rem; }
  .legal a { color:inherit; text-decoration:none; }
  @media (min-width:48rem) { .footer-grid { grid-template-columns:2fr repeat(2,1fr); } .contact { grid-column:3; } }
  @media (min-width:70rem) { .footer-grid { grid-template-columns:2.1fr repeat(3,1fr) 1.5fr; } .contact { grid-column:auto; } }
</style>
