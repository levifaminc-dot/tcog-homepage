---
interface Props { eyebrow: string; title: string; copy?: string; light?: boolean; align?: 'left' | 'center' }
const { eyebrow, title, copy, light = false, align = 'left' } = Astro.props;
---
<header class:list={['heading', { light, center: align === 'center' }]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {copy && <p class="copy">{copy}</p>}
</header>
<style>
  .heading { max-width:46rem; }
  .heading.center { margin-inline:auto; text-align:center; }
  .heading.center :global(.eyebrow) { justify-content:center; }
  .heading.center :global(.eyebrow)::after { width:1.85rem; height:2px; background:currentColor; content:""; }
  .heading.light :global(.section-title) { color:#fff; }
  .heading.light .copy { color:rgb(255 255 255 / .72); }
  .copy { margin:1.25rem 0 0; color:#5c6574; font-size:clamp(1rem, 1.5vw, 1.12rem); line-height:1.75; text-wrap:pretty; }
</style>
