---
import type { MarkProps } from 'astro-portabletext/types';

const { node } = Astro.props as MarkProps<{ _type: 'link'; href?: string }>;
const href = node.markDef?.href ?? '#';
const external = href.startsWith('http');
---
<a href={href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}><slot /></a>
