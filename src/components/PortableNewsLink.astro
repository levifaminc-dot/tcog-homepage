---
import type { MarkProps } from 'astro-portabletext/types';
import { safeContentHref } from '../lib/safeContentHref';

const { node } = Astro.props as MarkProps<{ _type: 'link'; href?: string }>;
const href = safeContentHref(node.markDef?.href);
const external = href?.startsWith('http');
---
{href ? <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}><slot /></a> : <slot />}
