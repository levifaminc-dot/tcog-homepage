---
import { Heart, MapPin, Menu, Search, X } from '@lucide/astro';
import Brand from './Brand.astro';
const nav = [
  { label: 'About', href: '/about/' },
  { label: 'Ministries', href: '/ministries/' },
  { label: 'Events', href: '/#events' },
  { label: 'Media', href: '/media/' },
  { label: 'News', href: '/news/' },
];
const currentPath = Astro.url.pathname;
---
<a class="skip" href="#main-content">Skip to content</a>
<header>
  <div class="utility">
    <div class="container-site utility-inner">
      <p>United by truth &amp; love across Nigeria</p>
      <div>
        <a href="/#prayer"><Heart size={13} stroke-width={2} /> Prayer request</a>
        <a href="https://www.thechurchofgod.org/" target="_blank" rel="noreferrer">International Offices <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
  <nav class="nav" aria-label="Primary navigation">
    <div class="container-site nav-inner">
      <Brand />
      <div class="desktop-links">{nav.map((item) => <a class:list={{ active: item.href !== '/#events' && currentPath.startsWith(item.href) }} aria-current={item.href !== '/#events' && currentPath.startsWith(item.href) ? 'page' : undefined} href={item.href}>{item.label}</a>)}</div>
      <div class="nav-actions">
        <button class="search" type="button" aria-label="Search the site"><Search size={20} /></button>
        <a class="finder" href="/#find-a-church"><MapPin size={16} /> Find a church</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><Menu class="menu-icon" size={24} /><X class="close-icon" size={24} /></button>
      </div>
    </div>
  </nav>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile navigation">
      {nav.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>)}
      <a href="/#giving">Give <span aria-hidden="true">→</span></a>
      <a class="mobile-finder" href="/#find-a-church"><MapPin size={18} /> Find a church near you</a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const openIcon = document.querySelector<SVGElement>('.menu-icon');
  const closeIcon = document.querySelector<SVGElement>('.close-icon');
  const setMenu = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    openIcon?.classList.toggle('hidden-icon', open);
    closeIcon?.classList.toggle('shown-icon', open);
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
  window.addEventListener('resize', () => { if (window.innerWidth >= 1024) setMenu(false); });
</script>
<style>
  .skip { position:fixed; z-index:100; top:.75rem; left:.75rem; transform:translateY(-180%); background:#fff; color:#12388b; border-radius:.5rem; padding:.75rem 1rem; font-weight:800; }
  .skip:focus { transform:none; }
  header { position:relative; z-index:50; }
  .utility { background:#0b286f; color:#fff; }
  .utility-inner { min-height:2.35rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; font-size:.7rem; font-weight:700; letter-spacing:.04em; }
  .utility p { margin:0; opacity:.78; }
  .utility-inner div { display:flex; align-items:center; gap:1.5rem; }
  .utility a { display:inline-flex; align-items:center; gap:.35rem; color:inherit; text-decoration:none; opacity:.9; }
  .nav { position:relative; background:rgb(255 255 255 / .98); border-bottom:1px solid rgb(16 24 39 / .08); }
  .nav-inner { min-height:5rem; display:flex; align-items:center; justify-content:space-between; gap:2rem; }
  .desktop-links { display:none; align-items:center; gap:clamp(1rem, 2vw, 2rem); }
  .desktop-links a { position:relative; color:#263247; font-size:.76rem; font-weight:800; letter-spacing:.065em; text-decoration:none; text-transform:uppercase; }
  .desktop-links a::after { position:absolute; right:0; bottom:-.55rem; left:0; height:2px; transform:scaleX(0); background:#d10a20; content:""; transition:transform .2s ease; }
  .desktop-links a:hover::after { transform:scaleX(1); }
  .desktop-links a.active::after { transform:scaleX(1); }
  .nav-actions { display:flex; align-items:center; gap:.4rem; }
  .search, .menu-toggle { display:grid; width:2.8rem; height:2.8rem; place-items:center; border:0; border-radius:50%; background:transparent; color:#12388b; cursor:pointer; }
  .search:hover, .menu-toggle:hover { background:#eef3ff; }
  .finder { display:none; min-height:2.9rem; align-items:center; gap:.45rem; border-radius:999px; background:#d10a20; color:#fff; padding:.75rem 1.1rem; font-size:.73rem; font-weight:900; letter-spacing:.04em; text-decoration:none; text-transform:uppercase; }
  .close-icon { display:none; }
  .hidden-icon { display:none !important; }
  .shown-icon { display:block !important; }
  .mobile-menu { position:absolute; top:100%; width:100%; min-height:calc(100vh - 7rem); background:#fff; border-top:1px solid #e5e7eb; padding:1.5rem var(--page-pad) 2rem; }
  .mobile-menu nav { display:grid; }
  .mobile-menu a { display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #e5e7eb; color:#12388b; padding:1rem 0; font-family:Georgia,serif; font-size:1.65rem; text-decoration:none; }
  .mobile-menu .mobile-finder { justify-content:center; gap:.55rem; margin-top:1.5rem; border:0; border-radius:999px; background:#d10a20; color:#fff; padding:1rem; font-family:inherit; font-size:.8rem; font-weight:900; letter-spacing:.05em; text-transform:uppercase; }
  @media (max-width: 40rem) { .utility p, .utility a:last-child, .search { display:none; } .utility-inner { justify-content:flex-end; } }
  @media (min-width: 48rem) { .finder { display:inline-flex; } }
  @media (min-width: 64rem) { .desktop-links { display:flex; } .menu-toggle { display:none; } }
</style>
