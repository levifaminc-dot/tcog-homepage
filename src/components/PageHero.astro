---
import { ArrowDown } from '@lucide/astro';
interface Props { eyebrow: string; title: string; copy: string; anchor?: string; label?: string; image?: string; imageAlt?: string; imagePosition?: string; }
const { eyebrow, title, copy, anchor = '#page-content', label = 'Explore this page', image, imageAlt = '', imagePosition = 'center' } = Astro.props;
---
<section class:list={['page-hero', { 'has-photo': image }]} aria-labelledby="page-title">
  {image ? <img class="hero-photo" src={image} alt={imageAlt} width="1600" height="1200" fetchpriority="high" decoding="async" style={`object-position: ${imagePosition}`} /> : <div class="motif" aria-hidden="true"></div>}
  {image && <div class="photo-veil" aria-hidden="true"></div>}
  <div class="container-site inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title">{title}</h1>
    <p class="copy">{copy}</p>
    <a href={anchor} class="jump"><span>{label}</span><span class="icon"><ArrowDown size={17} /></span></a>
  </div>
</section>
<style>
  .page-hero { position:relative; isolation:isolate; overflow:hidden; background:#12388b; color:#fff; }
  .hero-photo { position:absolute; z-index:-2; inset:0; width:100%; height:100%; object-fit:cover; }
  .photo-veil { position:absolute; z-index:-1; inset:0; background:linear-gradient(90deg, rgb(7 18 47 / .94) 0%, rgb(8 24 56 / .82) 39%, rgb(9 26 61 / .4) 72%, rgb(6 18 42 / .24) 100%), linear-gradient(0deg, rgb(6 18 42 / .5), transparent 55%); }
  .inner { min-height:clamp(31rem, 62vh, 43rem); display:flex; flex-direction:column; justify-content:center; padding-block:5rem 6rem; }
  .eyebrow { color:#f3c2e1; }
  .eyebrow::before { background:#d10a20; }
  h1 { max-width:62rem; margin:1.2rem 0 0; font-family:Georgia,serif; font-size:clamp(3.5rem, 8vw, 7rem); font-weight:400; letter-spacing:-.055em; line-height:.92; text-wrap:balance; }
  .copy { max-width:45rem; margin:1.8rem 0 0; color:rgb(255 255 255 / .84); font-size:clamp(1.05rem, 2vw, 1.3rem); line-height:1.7; text-wrap:pretty; }
  .jump { position:absolute; right:var(--page-pad); bottom:2rem; display:flex; align-items:center; gap:.8rem; color:#fff; font-size:.7rem; font-weight:900; letter-spacing:.12em; text-decoration:none; text-transform:uppercase; }
  .icon { display:grid; width:2.8rem; height:2.8rem; place-items:center; border:1px solid rgb(255 255 255 / .35); border-radius:50%; }
  .motif { position:absolute; z-index:-1; right:-6rem; bottom:-10rem; width:min(55vw, 48rem); aspect-ratio:1; border:1px solid rgb(162 43 140 / .35); border-radius:50%; box-shadow:0 0 0 5rem rgb(209 10 32 / .07), 0 0 0 10rem rgb(162 43 140 / .05); }
  @media (max-width:40rem) {
    .has-photo .inner { padding-bottom:17rem; }
    .has-photo .hero-photo { top:auto; height:15rem; }
    .photo-veil { top:auto; height:17rem; background:linear-gradient(180deg, #12388b 0%, rgb(18 56 139 / .28) 35%, rgb(6 18 42 / .12) 100%); }
    .jump { position:static; margin-top:2.5rem; align-self:flex-start; }
    .jump span:first-child { display:none; }
  }
</style>
