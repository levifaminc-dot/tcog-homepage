---
import { ArrowDown } from '@lucide/astro';
interface Props { eyebrow: string; title: string; copy: string; anchor?: string; label?: string; }
const { eyebrow, title, copy, anchor = '#page-content', label = 'Explore this page' } = Astro.props;
---
<section class="page-hero" aria-labelledby="page-title">
  <div class="motif" aria-hidden="true"></div>
  <div class="container-site inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title">{title}</h1>
    <p class="copy">{copy}</p>
    <a href={anchor} class="jump"><span>{label}</span><span class="icon"><ArrowDown size={17} /></span></a>
  </div>
</section>
<style>
  .page-hero { position:relative; isolation:isolate; overflow:hidden; background:#172554; color:#fff; }
  .inner { min-height:clamp(31rem, 62vh, 43rem); display:flex; flex-direction:column; justify-content:center; padding-block:5rem 6rem; }
  .eyebrow { color:#f1d58b; }
  .eyebrow::before { background:#d8a93d; }
  h1 { max-width:62rem; margin:1.2rem 0 0; font-family:Georgia,serif; font-size:clamp(3.5rem, 8vw, 7rem); font-weight:400; letter-spacing:-.055em; line-height:.92; text-wrap:balance; }
  .copy { max-width:45rem; margin:1.8rem 0 0; color:rgb(255 255 255 / .72); font-size:clamp(1.05rem, 2vw, 1.3rem); line-height:1.7; text-wrap:pretty; }
  .jump { position:absolute; right:var(--page-pad); bottom:2rem; display:flex; align-items:center; gap:.8rem; color:#fff; font-size:.7rem; font-weight:900; letter-spacing:.12em; text-decoration:none; text-transform:uppercase; }
  .icon { display:grid; width:2.8rem; height:2.8rem; place-items:center; border:1px solid rgb(255 255 255 / .35); border-radius:50%; }
  .motif { position:absolute; z-index:-1; right:-6rem; bottom:-10rem; width:min(55vw, 48rem); aspect-ratio:1; border:1px solid rgb(216 169 61 / .25); border-radius:50%; box-shadow:0 0 0 5rem rgb(216 169 61 / .05), 0 0 0 10rem rgb(216 169 61 / .035); }
  @media (max-width:40rem) { .jump { position:static; margin-top:2.5rem; align-self:flex-start; } .jump span:first-child { display:none; } }
</style>
