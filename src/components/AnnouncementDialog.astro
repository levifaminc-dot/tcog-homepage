---
import { ArrowUpRight, Bell, PartyPopper, TriangleAlert, X } from '@lucide/astro';
import type { Announcement } from '../lib/sanity';

interface Props { announcement: Announcement; }
const { announcement } = Astro.props;
const kind = announcement.kind ?? 'information';
const Icon = kind === 'urgent' ? TriangleAlert : kind === 'celebration' ? PartyPopper : Bell;
const memoryKey = `tcog-announcement:${announcement._id}:${announcement._updatedAt}`;
---

<dialog id="site-announcement" class:list={['announcement-dialog', `announcement-${kind}`]} aria-labelledby="announcement-title" aria-describedby="announcement-message" data-announcement-key={memoryKey} data-dismissible={announcement.dismissible !== false ? 'true' : 'false'}>
  <div class="announcement-card">
    <div class="announcement-accent" aria-hidden="true"></div>
    <div class="announcement-icon" aria-hidden="true"><Icon size={24} stroke-width={1.7} /></div>
    {announcement.dismissible !== false && <button class="announcement-close" type="button" aria-label="Close announcement" data-announcement-close><X size={20} /></button>}
    <p class="announcement-eyebrow">The Church of God Nigeria</p>
    <h2 id="announcement-title">{announcement.title}</h2>
    <p id="announcement-message">{announcement.message}</p>
    <div class="announcement-actions">
      {announcement.callToAction?.label && announcement.callToAction?.url && (
        <a class="btn btn-primary" href={announcement.callToAction.url} target={announcement.callToAction.openInNewTab ? '_blank' : undefined} rel={announcement.callToAction.openInNewTab ? 'noreferrer' : undefined}>
          {announcement.callToAction.label}<ArrowUpRight size={16} />
        </a>
      )}
      {announcement.dismissible !== false && <button class="announcement-later" type="button" data-announcement-close>Not now</button>}
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-announcement');
  if (dialog) {
    const key = dialog.dataset.announcementKey;
    const dismissed = key ? sessionStorage.getItem(key) === 'dismissed' : false;
    const dismissible = dialog.dataset.dismissible === 'true';
    const closeAnnouncement = () => {
      if (key) sessionStorage.setItem(key, 'dismissed');
      dialog.close();
    };
    dialog.querySelectorAll<HTMLElement>('[data-announcement-close]').forEach((button) => button.addEventListener('click', closeAnnouncement));
    dialog.addEventListener('cancel', (event) => {
      if (!dismissible) event.preventDefault();
      else if (key) sessionStorage.setItem(key, 'dismissed');
    });
    dialog.addEventListener('click', (event) => {
      if (dismissible && event.target === dialog) closeAnnouncement();
    });
    if (!dismissed) requestAnimationFrame(() => dialog.showModal());
  }
</script>

<style>
  .announcement-dialog { width: min(calc(100% - 2rem), 39rem); max-width: none; margin: auto; padding: 0; overflow: visible; border: 0; border-radius: 1.5rem; background: transparent; color: var(--color-ink); }
  .announcement-dialog::backdrop { background: rgb(9 19 54 / .74); backdrop-filter: blur(6px); }
  .announcement-card { position: relative; overflow: hidden; border-radius: 1.5rem; background: white; padding: 2rem; box-shadow: 0 2rem 6rem rgb(9 19 54 / .32); }
  .announcement-accent { position: absolute; inset: 0 auto 0 0; width: .45rem; background: var(--color-indigo); }
  .announcement-icon { display: grid; width: 3.25rem; height: 3.25rem; place-items: center; border-radius: 999px; background: var(--color-mist); color: var(--color-indigo); }
  .announcement-close { position: absolute; top: 1rem; right: 1rem; display: grid; width: 2.75rem; height: 2.75rem; cursor: pointer; place-items: center; border: 0; border-radius: 999px; background: #f1f5f9; color: var(--color-indigo); }
  .announcement-eyebrow { margin: 1.25rem 0 0; color: var(--color-coral); font-size: .68rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; }
  h2 { margin: .55rem 2.5rem 0 0; color: var(--color-indigo); font-family: var(--font-display); font-size: clamp(2rem, 6vw, 3rem); font-weight: 400; letter-spacing: -.04em; line-height: 1; }
  #announcement-message { margin: 1rem 0 0; color: #475569; line-height: 1.75; white-space: pre-line; }
  .announcement-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.6rem; }
  .announcement-later { min-height: 2.75rem; cursor: pointer; border: 0; background: transparent; color: var(--color-indigo); font: inherit; font-size: .82rem; font-weight: 800; }
  .announcement-urgent .announcement-icon { background: #fee2e2; color: #b91c1c; }
  .announcement-urgent .announcement-accent { background: #b91c1c; }
  .announcement-celebration .announcement-icon { background: #fce7f3; color: var(--color-coral); }
  .announcement-celebration .announcement-accent { background: var(--color-coral); }
  @media (min-width: 40rem) { .announcement-card { padding: 2.5rem; } }
  @media (prefers-reduced-motion: no-preference) { .announcement-dialog[open] { animation: announcement-in .28s ease-out; } @keyframes announcement-in { from { opacity: 0; transform: translateY(1rem) scale(.98); } } }
</style>
